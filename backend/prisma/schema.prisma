generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DriverStatus {
  AVAILABLE
  EN_ROUTE
  IN_PROGRESS
  OFFLINE
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VehicleOwnership {
  OWNER_OPERATOR
  LEASED
}

enum AssignmentStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                  Role[]
  driverProfile          DriverProfile?      @relation("DriverProfileOwner")
  dispatcherProfile      DispatcherProfile?
  assignedDrivers        DriverProfile[]     @relation("AssignedDispatcher")
  assignmentsAsDriver    Assignment[]        @relation("DriverAssignments")
  assignmentsAsDispatcher Assignment[]       @relation("DispatcherAssignments")
  ownedVehicles          Vehicle[]           @relation("VehicleOwner")
  driverVehicles         DriverVehicle[]     @relation("DriverVehicleLink")
}

model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]
}

model DriverProfile {
  driverId             Int          @id
  licenseNo            String
  licenseClass         String
  licenseExpiry        DateTime
  status               DriverStatus @default(OFFLINE)
  assignedDispatcherId Int?
  lastLat              Float?
  lastLng              Float?
  lastLocationAt       DateTime?
  lastLocationLabel    String?
  lastGeocodedLat      Float?
  lastGeocodedLng      Float?
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  driver     User  @relation("DriverProfileOwner", fields: [driverId], references: [id], onDelete: Cascade)
  dispatcher User? @relation("AssignedDispatcher", fields: [assignedDispatcherId], references: [id])
}

model DispatcherProfile {
  dispatcherId Int      @id
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dispatcher User @relation(fields: [dispatcherId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id            Int               @id @default(autoincrement())
  make          String
  model         String
  year          Int
  vin           String            @unique
  plate         String            @unique
  status        VehicleStatus     @default(AVAILABLE)
  ownership     VehicleOwnership  @default(LEASED)
  ownerDriverId Int?
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  assignments   Assignment[]
  driverVehicles DriverVehicle[]   @relation("DriverVehicleLink")
  ownerDriver   User?              @relation("VehicleOwner", fields: [ownerDriverId], references: [id])
}

model DriverVehicle {
  id        Int      @id @default(autoincrement())
  driverId  Int
  vehicleId Int
  createdAt DateTime @default(now())

  driver  User    @relation("DriverVehicleLink", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation("DriverVehicleLink", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([driverId, vehicleId])
}

model Assignment {
  id           Int              @id @default(autoincrement())
  driverId     Int
  vehicleId    Int
  dispatcherId Int
  assignedAt   DateTime         @default(now())
  startsAt     DateTime?
  endsAt       DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  status       AssignmentStatus @default(SCHEDULED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  driver     User    @relation("DriverAssignments", fields: [driverId], references: [id])
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  dispatcher User    @relation("DispatcherAssignments", fields: [dispatcherId], references: [id])
}

model StatSnapshot {
  id             Int      @id @default(autoincrement())
  month          DateTime @unique
  activeDrivers  Int
  totalVehicles  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
